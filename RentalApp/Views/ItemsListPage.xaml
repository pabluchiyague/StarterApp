<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RentalApp.Views.ItemsListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RentalApp.Database.Models;assembly=RentalApp.Database"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry Placeholder="Search items"
                   Text="{Binding SearchText}" />
            <Button Grid.Column="1"
                    Text="Search"
                    Command="{Binding SearchCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Picker Title="Category"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    ItemDisplayBinding="{Binding Name}" />
            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearFiltersCommand}" />
            <Button Grid.Column="2"
                    Text="List"
                    Command="{Binding CreateItemCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <Label Text="No items found."
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Item">
                        <Border StrokeThickness="1"
                                Stroke="#DDDDDD"
                                Padding="12"
                                Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding DailyRate, StringFormat='£{0:0.00}/day'}"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto"
                                      Margin="0,8,0,0">
                                    <Label Text="{Binding Owner.FullName, StringFormat='Owner: {0}'}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Owner.AverageRating, StringFormat='Owner rating: {0:0.0}/5',
                                                          TargetNullValue='Owner rating: No rating yet'}" />
                                </Grid>
                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto"
                                      Margin="0,8,0,0">
                                    <Label Text="{Binding Category.Name}" />
                                    <Button Grid.Column="1"
                                            Text="View"
                                            Command="{Binding BindingContext.OpenItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
