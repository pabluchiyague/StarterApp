<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="RentalApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:RentalApp.Views"
       Shell.FlyoutBehavior="Disabled">

    <!--
        First child of the Shell = first page the user sees.
        Login is shown on app start; flyout is disabled here so users
        can't bypass it. After successful login the LoginViewModel
        navigates to "//notes" which switches Shell to the FlyoutItem
        section below.
    -->
    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Shell.FlyoutBehavior="Disabled" />

    <!-- Post-login content: visible flyout once authenticated -->
    <FlyoutItem Title="Notes"
                Icon="notes_icon.png"
                FlyoutDisplayOptions="AsSingleItem"
                Shell.FlyoutBehavior="Flyout">
        <ShellContent Title="My Notes"
                      ContentTemplate="{DataTemplate views:NotesPage}"
                      Route="notes" />
    </FlyoutItem>

    <FlyoutItem Title="About"
                Icon="info_icon.png"
                FlyoutDisplayOptions="AsSingleItem"
                Shell.FlyoutBehavior="Flyout">
        <ShellContent Title="About"
                      ContentTemplate="{DataTemplate views:AboutPage}"
                      Route="about" />
    </FlyoutItem>

</Shell>
